---
import Base from "../layouts/Base.astro";
import ToolLogo from "../components/ToolLogo.astro";
import { hub, summary } from "../lib/data.ts";
import { CHART_THEMES, pricingChart } from "../../../lib/svg.ts";
import { isStale, sortRows } from "../lib/pricing.ts";
import { issueUrl } from "../lib/url.ts";

const rows = sortRows(
  hub.tools
    .filter((t) => t.pricing)
    .map((t) => ({ tool: t, p: t.pricing!, name: t.pricing!.label ?? t.name, entry_usd: t.pricing!.entry_usd ?? null, verified: t.pricing!.last_verified })),
  "price",
);
// The same chart function draws the README image, so both always agree.
const fit = (svg: string, cls: string) => svg.replace(/ width="\d+" height="\d+"/, ` class="${cls}"`);
const chartLight = fit(pricingChart(hub.tools, hub.categories, CHART_THEMES.paper), "diagram-light h-auto w-full");
const chartDark = fit(pricingChart(hub.tools, hub.categories, CHART_THEMES.night), "diagram-dark h-auto w-full");

const prices = rows.map((r) => r.entry_usd).filter((v): v is number => v !== null).sort((a, b) => a - b);
const median = prices[Math.floor(prices.length / 2)]!;
const under20 = prices.filter((p) => p <= 20).length;
---

<Base
  title="Vibe coding tool pricing"
  description={`Entry prices for ${summary.prices} vibe coding tools, taken from vendor pages and verified ${summary.latestVerified}. Lovable, Bolt, Replit, v0, Cursor, Claude Code and more.`}
  editPath="data/tools"
>
  <section class="container-x pt-14">
    <p class="eyebrow">Pricing · verified {summary.latestVerified}</p>
    <h1 class="display mt-4 max-w-4xl text-[clamp(2.8rem,6vw,5rem)]">What it really costs per month</h1>
    <p class="lead mt-6 max-w-3xl">
      USD before tax, billed monthly unless noted. Every row links to the vendor's own page and shows the month we checked it. Most AI tools bill by credits or usage pools, so your real cost depends on how much you build.
    </p>
  </section>

  <section class="container-x mt-12">
    <dl class="mono grid grid-cols-2 border-y border-ink text-sm md:grid-cols-4">
      <div class="py-4 pr-4">
        <dt class="text-faint">Cheapest entry plan</dt>
        <dd class="mt-1 font-serif text-4xl text-ink">${prices[0]}</dd>
      </div>
      <div class="border-l border-rule py-4 pl-5">
        <dt class="text-faint">Median entry plan</dt>
        <dd class="mt-1 font-serif text-4xl text-ink">${median}</dd>
      </div>
      <div class="border-rule py-4 md:border-l md:pl-5">
        <dt class="text-faint">At $20 or less</dt>
        <dd class="mt-1 font-serif text-4xl text-ink">{under20} <span class="text-lg text-faint">of {prices.length}</span></dd>
      </div>
      <div class="border-l border-rule py-4 pl-5">
        <dt class="text-faint">Most expensive entry</dt>
        <dd class="mt-1 font-serif text-4xl text-ink">${prices.at(-1)}</dd>
      </div>
    </dl>
  </section>

  <section class="container-x mt-10 grid gap-8 lg:grid-cols-[1.35fr_1fr]">
    <figure class="overflow-hidden rounded-[10px] border border-rule">
      <Fragment set:html={chartLight} />
      <Fragment set:html={chartDark} />
    </figure>
    <aside class="flex flex-col gap-4">
      <div class="callout callout-tip">
        <p class="callout-title">The plan fee is only part of it</p>
        <p class="text-ink-2">AI builders spend credits on every change, including fixes, and hosted backends charge for data and compute once you have users. Set a usage alert wherever the tool offers one.</p>
      </div>
      <div class="callout">
        <p class="callout-title">How to read a credit price</p>
        <p class="text-ink-2">A $25 plan with 100 credits is roughly 100 changes. Small edits use less, large refactors use more, and a fix that needs three tries costs three times.</p>
      </div>
      <div class="callout callout-note">
        <p class="callout-title">Spotted a change?</p>
        <p class="text-ink-2">Prices move every few weeks. Each row below has a link that opens a prefilled issue.</p>
      </div>
    </aside>
  </section>

  <section class="container-x mt-14" aria-labelledby="table-title">
    <header class="section-head">
      <span class="section-num">All plans</span>
      <h2 id="table-title" class="section-title">Every price, with its source</h2>
      <p class="text-sm text-muted">Click a column to sort.</p>
    </header>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[960px] text-left text-sm" id="price-table">
        <thead class="mono border-b border-ink text-xs uppercase tracking-[0.06em] text-faint">
          <tr>
            <th scope="col" class="py-3 pr-4" aria-sort="none"><button type="button" class="sort-btn" data-sort="name">Tool <span class="sort-icon" aria-hidden="true"></span></button></th>
            <th scope="col" class="py-3 pr-4">Free plan</th>
            <th scope="col" class="py-3 pr-4" aria-sort="ascending"><button type="button" class="sort-btn" data-sort="price">Entry price <span class="sort-icon" aria-hidden="true"></span></button></th>
            <th scope="col" class="py-3 pr-4">Higher plans</th>
            <th scope="col" class="py-3 pr-4">How usage is measured</th>
            <th scope="col" class="py-3" aria-sort="none"><button type="button" class="sort-btn" data-sort="verified">Verified <span class="sort-icon" aria-hidden="true"></span></button></th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr data-row data-name={r.name} data-price={r.entry_usd ?? ""} data-verified={r.verified} class="border-b border-rule align-top">
                <th scope="row" class="py-4 pr-4 font-normal">
                  <span class="flex items-center gap-3">
                    <ToolLogo tool={r.tool} size={32} />
                    <span class="font-medium text-ink">{r.name}</span>
                  </span>
                </th>
                <td class="py-4 pr-4 text-muted">{r.p.free_plan}</td>
                <td class="py-4 pr-4">
                  <span class="block font-medium text-ink">{r.p.entry}</span>
                  {r.entry_usd !== null && <span class="mono text-xs text-faint">${r.entry_usd}/mo{r.p.entry_yearly ? ", billed yearly" : ""}</span>}
                </td>
                <td class="py-4 pr-4 text-muted">{r.p.higher}</td>
                <td class="py-4 pr-4 text-muted">{r.p.unit}</td>
                <td class="py-4 text-muted">
                  <span class="mono whitespace-nowrap text-ink">{r.verified}</span>
                  <span class="tag tag-stale ml-1" data-stale hidden={!isStale(r.verified)}>re-check</span>
                  <span class="mt-2 flex flex-col gap-1 text-xs">
                    {r.p.sources.map((s) => (
                      <a class="underline decoration-rule-strong underline-offset-2 hover:text-accent" href={s.url} rel="noopener">{s.label} ↗</a>
                    ))}
                    <a class="underline decoration-rule-strong underline-offset-2 hover:text-accent" href={issueUrl("pricing-update.yml", `[Pricing] ${r.name}`)}>Report a change</a>
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { isStale, sortRows, type SortKey } from "../lib/pricing.ts";

  const table = document.getElementById("price-table")!;
  const body = table.querySelector("tbody")!;
  const rows = [...body.querySelectorAll<HTMLTableRowElement>("[data-row]")].map((el) => ({
    el,
    name: el.dataset.name!,
    entry_usd: el.dataset.price ? Number(el.dataset.price) : null,
    verified: el.dataset.verified!,
  }));

  // Re-check staleness against today's date, since the page may be older than the data.
  for (const r of rows) {
    const tag = r.el.querySelector<HTMLElement>("[data-stale]");
    if (tag) tag.hidden = !isStale(r.verified);
  }

  let key: SortKey = "price";
  let dir: "asc" | "desc" = "asc";
  table.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const next = btn.dataset.sort as SortKey;
      dir = next === key && dir === "asc" ? "desc" : "asc";
      key = next;
      for (const r of sortRows(rows, key, dir)) body.appendChild(r.el);
      table.querySelectorAll("th[aria-sort]").forEach((th) => th.setAttribute("aria-sort", "none"));
      btn.closest("th")!.setAttribute("aria-sort", dir === "asc" ? "ascending" : "descending");
    }),
  );
</script>
