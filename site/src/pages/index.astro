---
import Base from "../layouts/Base.astro";
import ToolLogo from "../components/ToolLogo.astro";
import { hub, summary, byCategory, shortTitle, toolBySlug } from "../lib/data.ts";
import { withBase } from "../lib/url.ts";

const paths = [
  { n: "A", title: "I have an idea and have never shipped an app", text: "Three questions, then a starting tool set with prices.", href: "/which-tool", cta: "Find a starting stack" },
  { n: "B", title: "I want to know what this will cost", text: `Entry plans for ${summary.prices} tools, each checked on the vendor's own page.`, href: "/pricing", cta: "Compare prices" },
  { n: "C", title: "It works on my screen. Is it safe to launch?", text: "Eight checks that catch the problems AI-built apps ship with most often.", href: "/roadmap/#before-you-launch", cta: "Open the launch checklist" },
  { n: "D", title: "Something broke and the AI keeps making it worse", text: "A six-step method, three prompts, and when to stop prompting.", href: "/when-it-breaks", cta: "Debug it calmly" },
  { n: "E", title: "I code, and want an agent in my own repo", text: "AI IDEs and terminal agents that work on an existing codebase.", href: "/tools/?category=cli-agents", cta: "See the agents" },
];

// The cheapest verified entry plan per category, for the hero panel.
const cheapest = hub.categories
  .map((c) => {
    const priced = byCategory(c.id).filter((t) => t.pricing?.entry_usd !== undefined);
    priced.sort((a, b) => a.pricing!.entry_usd! - b.pricing!.entry_usd!);
    return priced[0] ? { cat: c, tool: priced[0] } : null;
  })
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

const marquee = [...hub.tools].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)));
const stageColor = (i: number) => `var(--stage-${i + 1})`;

// Bento layout: the first category gets the large tile.
const [lead, ...restCats] = hub.categories;
const leadTools = byCategory(lead!.id);
const featuredStack = ["lovable", "supabase", "clerk", "stripe", "vercel", "sentry"].map(toolBySlug);
---

<Base
  title="Vibe Coding Hub"
  description={`Free, community-maintained guide for vibe coders: ${summary.tools} tools, ${summary.freeTiers} free tiers, prices verified ${summary.latestVerified}, and a roadmap for keeping an AI-built app alive.`}
  editPath="README.md"
>
  <!-- Hero -->
  <section class="container-x pb-14 pt-12 lg:pt-20">
    <p class="eyebrow">A field guide for people who build with AI · verified {summary.latestVerified}</p>
    <div class="mt-6 grid gap-12 lg:grid-cols-[1.25fr_1fr] lg:items-end">
      <div>
        <h1 class="display text-[clamp(3.2rem,8.6vw,7.4rem)]">
          Ship the app.<br />Keep it <em>alive.</em>
        </h1>
        <p class="lead mt-8 max-w-xl">
          The tools, the real prices, and the habits that keep an AI-built app working after the demo. Written from vendor pages and official docs, and corrected by anyone in the open.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary no-underline" href={withBase("/roadmap")}>Walk the roadmap →</a>
          <a class="btn no-underline" href={withBase("/tools")}>Browse {summary.tools} tools</a>
        </div>
      </div>

      <aside class="panel-box overflow-hidden" aria-labelledby="cheapest-title">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-rule px-5 py-3">
          <h2 id="cheapest-title" class="eyebrow text-ink">Cheapest way in, by category</h2>
          <span class="mono text-xs text-faint">USD / month</span>
        </div>
        <table class="w-full text-sm">
          <caption class="sr-only">The cheapest verified paid plan in each category</caption>
          <tbody>
            {
              cheapest.map(({ cat, tool }) => (
                <tr class="border-b border-rule last:border-0">
                  <th scope="row" class="py-2.5 pl-5 pr-3 text-left font-normal">
                    <span class="flex items-center gap-3">
                      <ToolLogo tool={tool} size={28} />
                      <span>
                        <span class="block font-medium text-ink">{tool.pricing!.label ?? tool.name}</span>
                        <span class="block text-xs text-faint">{shortTitle(cat)}</span>
                      </span>
                    </span>
                  </th>
                  <td class="mono py-2.5 pr-5 text-right text-ink">
                    ${tool.pricing!.entry_usd}
                    {tool.pricing!.entry_yearly && <span class="text-faint">*</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="flex items-center justify-between border-t border-rule bg-paper-2 px-5 py-3 text-sm">
          <span class="mono text-xs text-faint">* billed yearly · from vendor pages</span>
          <a class="link-arrow" href={withBase("/pricing")}>All {summary.prices} prices →</a>
        </div>
      </aside>
    </div>

    <dl class="mono mt-14 grid grid-cols-2 border-y border-ink text-sm sm:grid-cols-4">
      {
        [
          [summary.tools, "tools listed"],
          [summary.freeTiers, "free tiers documented"],
          [summary.prices, "prices with a date"],
          [summary.openSource, "open source"],
        ].map(([n, label], i) => (
          <div class:list={["py-4", i > 0 && "sm:border-l sm:border-rule sm:pl-5", i % 2 === 1 && "border-l border-rule pl-5 sm:pl-5"]}>
            <dt class="text-faint">{label}</dt>
            <dd class="mt-1 font-serif text-4xl text-ink">{n}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Logo strip -->
  <section class="border-y border-rule bg-paper-2 py-5" aria-label="Tools in the directory">
    <div class="marquee">
      <ul class="marquee-track" aria-hidden="true">
        {[...marquee, ...marquee].map((t) => <li><ToolLogo tool={t} size={40} /></li>)}
      </ul>
    </div>
    <p class="sr-only">{hub.tools.map((t) => t.name).join(", ")}</p>
  </section>

  <!-- 01 Pick your path -->
  <section class="container-x section reveal" aria-labelledby="paths-title">
    <header class="section-head">
      <span class="section-num">01</span>
      <h2 id="paths-title" class="section-title">Start where you are</h2>
      <p class="text-sm text-muted">Five common situations, one page each.</p>
    </header>
    <ol>
      {
        paths.map((p) => (
          <li class="border-b border-rule">
            <a class="group grid gap-2 py-5 no-underline md:grid-cols-[3rem_1.4fr_1fr_auto] md:items-center md:gap-6" href={withBase(p.href)}>
              <span class="mono text-sm text-faint">{p.n}</span>
              <span class="font-serif text-[1.65rem] leading-tight group-hover:text-accent">{p.title}</span>
              <span class="text-muted">{p.text}</span>
              <span class="text-sm font-medium text-ink group-hover:text-accent">{p.cta} →</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 02 Roadmap -->
  <section class="border-y border-rule bg-paper-2 reveal" aria-labelledby="roadmap-title">
    <div class="container-x section">
      <header class="section-head">
        <span class="section-num">02</span>
        <h2 id="roadmap-title" class="section-title">From first prompt to a healthy app</h2>
        <a class="link-arrow text-sm" href={withBase("/roadmap")}>Open the interactive roadmap →</a>
      </header>
      <ol class="relative grid gap-8 md:grid-cols-5 md:gap-6">
        <span class="absolute left-[11px] top-3 hidden h-px w-[calc(100%-22px)] bg-ink md:block" aria-hidden="true"></span>
        {
          hub.guide.map((s, i) => (
            <li class="relative">
              <a class="group block no-underline" href={withBase(`/roadmap/#${s.id}`)}>
                <span class="relative z-10 grid h-6 w-6 place-items-center rounded-full border border-ink bg-paper mono text-[0.7rem]" style={`color:${stageColor(i)}`}>
                  {s.order}
                </span>
                <span class="mt-4 block font-serif text-2xl leading-tight group-hover:text-accent">{s.title}</span>
                <span class="mt-2 block text-sm text-muted">{s.summary.split(".")[0]}.</span>
                <ul class="mono mt-3 space-y-1 text-xs text-faint">
                  {s.topics.slice(0, 3).map((t) => (
                    <li>— {t}</li>
                  ))}
                </ul>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 03 Directory -->
  <section class="container-x section reveal" aria-labelledby="cats-title">
    <header class="section-head">
      <span class="section-num">03</span>
      <h2 id="cats-title" class="section-title">The directory</h2>
      <a class="link-arrow text-sm" href={withBase("/tools")}>All {summary.tools} tools →</a>
    </header>

    <div class="grid gap-px overflow-hidden rounded-[10px] border border-rule bg-rule md:grid-cols-4">
      <a class="group flex flex-col bg-surface p-6 no-underline md:col-span-2 md:row-span-2" href={withBase(`/tools/?category=${lead!.id}`)}>
        <span class="mono text-xs text-faint">{leadTools.length} tools · {leadTools.filter((t) => t.free_tier).length} with a free tier</span>
        <span class="mt-3 font-serif text-4xl leading-tight group-hover:text-accent">{lead!.title}</span>
        <span class="mt-3 max-w-md text-muted">{lead!.intro}</span>
        <ul class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-5">
          {leadTools.map((t) => (
            <li class="flex flex-col items-center gap-1.5 text-center">
              <ToolLogo tool={t} size={44} />
              <span class="text-xs text-muted">{t.name}</span>
            </li>
          ))}
        </ul>
        <span class="mt-auto pt-6 text-sm font-medium group-hover:text-accent">Compare builders →</span>
      </a>
      {
        restCats.map((c, i) => {
          const tools = byCategory(c.id);
          const wide = i === restCats.length - 1 && restCats.length % 2 === 1;
          return (
            <a class:list={["group flex flex-col bg-surface p-5 no-underline", wide && "md:col-span-2"]} href={withBase(`/tools/?category=${c.id}`)}>
              <span class="mono text-xs text-faint">{tools.length} tools</span>
              <span class="mt-2 font-serif text-2xl leading-tight group-hover:text-accent">{shortTitle(c)}</span>
              <span class="mt-2 text-sm text-muted">{c.best_for}.</span>
              <span class="mt-4 flex flex-wrap gap-1.5" aria-hidden="true">
                {tools.slice(0, 5).map((t) => <ToolLogo tool={t} size={28} />)}
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- 04 A typical stack -->
  <section class="border-t border-rule reveal" aria-labelledby="stack-title">
    <div class="container-x section grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div>
        <span class="section-num">04</span>
        <h2 id="stack-title" class="section-title mt-2">What a small SaaS usually runs on</h2>
        <p class="lead mt-4">
          One common starting stack for a vibe-coded SaaS with login and payments. It isn't the only answer, and the which-tool finder will suggest others for your case.
        </p>
        <a class="btn mt-6 no-underline" href={withBase("/which-tool")}>Find yours →</a>
      </div>
      <ol class="panel-box divide-y divide-rule">
        {
          featuredStack.map((t, i) => (
            <li class="flex items-center gap-4 px-5 py-3">
              <span class="mono w-6 text-xs text-faint">{String(i + 1).padStart(2, "0")}</span>
              <ToolLogo tool={t} size={32} />
              <span class="flex-1">
                <span class="block font-medium">{t.name}</span>
                <span class="block text-sm text-muted">{shortTitle(hub.categories.find((c) => c.id === t.category)!)}</span>
              </span>
              <span class="mono text-sm text-ink">{t.free_tier ? "free tier" : t.pricing ? `$${t.pricing.entry_usd}` : "per use"}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
