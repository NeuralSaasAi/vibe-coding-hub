---
import type { Tool } from "../../../schema/tool.ts";
import ToolLogo from "./ToolLogo.astro";
import { categoryOf, shortTitle } from "../lib/data.ts";
import { editUrl } from "../lib/url.ts";

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const cat = categoryOf(tool);
const price = tool.pricing;
const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n));
---

<li
  class="card card-hover relative flex flex-col p-5"
  data-tool
  data-slug={tool.slug}
  data-name={tool.name}
  data-description={tool.description}
  data-category={tool.category}
  data-free={tool.free_tier ? "1" : "0"}
  data-open={tool.open_source ? "1" : "0"}
>
  <div class="flex items-start gap-3">
    <ToolLogo tool={tool} />
    <div class="min-w-0">
      <h3 class="font-bold leading-tight">
        <a href={tool.url} rel="noopener" class="no-underline after:absolute after:inset-0 after:content-['']">{tool.name}</a>
      </h3>
      <p class="mt-1 text-xs font-semibold" style={`color:${cat.color}`}>{cat.emoji} {shortTitle(cat)}</p>
    </div>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-muted">{tool.description}</p>
  <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4">
    {tool.free_tier && <span class="tag tag-free">Free tier</span>}
    {tool.open_source && <span class="tag tag-open">Open source</span>}
    {price && (
      <span class="tag tag-price" title={`${price.entry}. Verified ${price.last_verified}`}>
        {price.entry_usd !== undefined ? `From $${price.entry_usd}/mo${price.entry_yearly ? "*" : ""}` : price.entry}
      </span>
    )}
    {tool.stars !== undefined && <span class="tag tag-price" title={tool.last_commit ? `Last commit ${tool.last_commit}` : undefined}>★ {fmt(tool.stars)}</span>}
  </div>
  <div class="relative z-10 mt-3 flex items-center justify-between text-xs text-faint">
    <span>{price ? `Price verified ${price.last_verified}` : tool.free_details ? `Free tier verified ${tool.free_details.last_verified}` : " "}</span>
    <a class="underline hover:text-ink" href={editUrl(`data/tools/${tool.slug}.yml`)}>Edit</a>
  </div>
</li>
